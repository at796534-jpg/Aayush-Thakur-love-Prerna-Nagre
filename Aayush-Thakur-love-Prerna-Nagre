    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cyber: {
                            black: '#030308',
                            dark: '#0a0a12',
                            red: '#ff0033',
                            lightRed: '#ff3366',
                            blue: '#00d2ff',
                            deepBlue: '#0055ff',
                            glass: 'rgba(10, 10, 18, 0.88)'
                        }
