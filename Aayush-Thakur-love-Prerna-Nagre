                    <button onclick="filterShayariLang('English', this)" class="lang-tab clip-button px-3 py-1 font-orbitron text-xs font-bold bg-black border border-cyber-blue/40 text-cyber-blue hover:bg-cyber-blue hover:text-black transition">ENGLISH</button>
                    <button onclick="filterShayariLang('Urdu', this)" class="lang-tab clip-button px-3 py-1 font-orbitron text-xs font-bold bg-black border border-cyber-blue/40 text-cyber-blue hover:bg-cyber-blue hover:text-black transition">URDU</button>
