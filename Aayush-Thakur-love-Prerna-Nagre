    <style>
        body {
            background-color: #030308;
            color: #ffffff;
            font-family: 'Rajdhani', sans-serif;
            overflow-x: hidden;
        }

        /* Background Image Slideshow with Provided Images */
        .bg-slideshow {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -2;
            pointer-events: none;
        }

        .bg-slide {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            opacity: 0;
            transition: opacity 1.5s ease-in-out;
            filter: brightness(0.4) contrast(1.1);
        }

        .bg-slide.active {
            opacity: 1;
        }

        .bg-cyber-overlay {
            position: fixed;
            inset: 0;
            z-index: -1;
            background-image: 
                linear-gradient(to right, rgba(0, 210, 255, 0.05) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 0, 51, 0.05) 1px, transparent 1px);
            background-size: 35px 35px;
            pointer-events: none;
        }

        .glow-red {
            box-shadow: 0 0 20px rgba(255, 0, 51, 0.6);
        }
        .glow-blue {
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.6);
        }
        .text-glow-red {
            text-shadow: 0 0 10px rgba(255, 0, 51, 0.8);
        }
        .text-glow-blue {
            text-shadow: 0 0 10px rgba(0, 210, 255, 0.8);
        }

        .cyber-panel {
            background: rgba(10, 10, 18, 0.88);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(0, 210, 255, 0.3);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.8);
        }

        .cyber-panel:hover {
            border-color: rgba(255, 0, 51, 0.6);
        }

        .clip-corner {
            clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 16px 100%, 0 calc(100% - 16px));
        }

        .clip-button {
            clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
        }

        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #030308;
        }
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(to bottom, #00d2ff, #ff0033);
            border-radius: 4px;
        }

        #heartCanvas {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
        }
    </style>
</head>
<body class="relative min-h-screen flex flex-col justify-between overflow-x-hidden">

