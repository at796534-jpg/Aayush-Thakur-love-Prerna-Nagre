                <p>AAYUSH THAKUR &amp; PURE LOVE PRERNA NAGRE</p>
            </div>
            <div class="text-cyber-red font-bold flex items-center gap-2">
                <span>BEST LOVER IN THE WORLD</span> <i class="fa-solid fa-heart"></i>
            </div>
        </div>
    </footer>

    <script>
        /* Slideshow Script */
        const slides = document.querySelectorAll('.bg-slide');
        let currentSlide = 0;

        function rotateBackground() {
            slides[currentSlide].classList.remove('active');
            currentSlide = (currentSlide + 1) % slides.length;
            slides[currentSlide].classList.add('active');
        }

        setInterval(rotateBackground, 5000);

        function setSlideBackground(index) {
            slides.forEach(s => s.classList.remove('active'));
            currentSlide = index;
            slides[currentSlide].classList.add('active');
        }

        /* Multi-Language Shayari Database */
        const shayariDatabase = [
            { lang: 'Hindi', text: 'तेरी आँखों की चमक में खो जाता हूँ, जब भी देखता हूँ तुझे, बस तेरा ही हो जाता हूँ।', target: 'Prerna & Aayush' },
            { lang: 'Hindi', text: 'ना चांद की चाहत, ना सितारों की फरमाइश, हर जन्म में मिले प्रेरणा का प्यार, बस यही है आयूष की ख्वाहिश।', target: 'Best Lover' },
            { lang: 'Hindi', text: 'तेरी सादगी ही मेरा दिल चुरा लेती है, जब तू मुस्कुराती है तो पूरी दुनिया खूबसूरत लगती है।', target: 'Pure Love' },
            { lang: 'Hindi', text: 'दिल के हर एक तार पर लिखा है नाम तुम्हारा, आयूष की हर सांस पर है प्रेरणा का सहारा।', target: 'Aayush & Prerna' },
            { lang: 'English', text: 'In a universe full of noise, your voice is my favorite melody, Prerna.', target: 'Eternal Love' },
            { lang: 'English', text: 'You are the only constant variable in my infinite code of life.', target: 'Pure Connection' },
            { lang: 'English', text: 'My heart beats in sync with your smile, today and forever.', target: 'Best Lover' },
            { lang: 'Urdu', text: 'تمہاری مسکراہٹ ہی میری زندگی کا حاصل ہے، تمہارے بغیر یہ دل بالکل ادھورا ہے۔', target: 'Dil Ki Baat' },
            { lang: 'Urdu', text: 'محبت میں ہر حد پار کر جائیں گے، آیوُش اور پریرنا ہمیشہ ایک ساتھ رہیں گے۔', target: 'Always & Forever' },
            { lang: 'Japanese', text: 'プレルナ、私の心は永遠にあなたとだけ動いています。 (My heart moves only with you forever, Prerna.)', target: 'Futuristic Love' },
            { lang: 'French', text: 'Prerna, tu es la raison pour laquelle mon cœur bat à chaque instant.', target: 'True Passion' }
        ];

        let activeLanguage = 'all';

        function renderShayaris(items) {
            const grid = document.getElementById('shayariGrid');
            grid.innerHTML = '';

            if (items.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-8 text-gray-400 font-orbitron">NO SHAYARI FOUND FOR YOUR SEARCH. TRY ANOTHER KEYWORD!</div>`;
                return;
            }

            items.forEach(item => {
                const card = document.createElement('div');
                card.className = 'bg-black/90 border border-cyber-blue/30 hover:border-cyber-red rounded-xl p-5 space-y-4 transition duration-300 flex flex-col justify-between';
                card.innerHTML = `
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-orbitron font-bold text-black bg-cyber-blue px-2 py-0.5 rounded">${item.lang}</span>
                            <span class="text-xs font-orbitron text-cyber-red">${item.target}</span>
                        </div>
                        <p class="font-rajdhani text-sm sm:text-base text-gray-200 leading-relaxed italic">"${item.text}"</p>
                    </div>
                    <div class="pt-3 border-t border-gray-800 flex justify-between items-center text-xs font-orbitron">
                        <span class="text-cyber-blue"><i class="fa-solid fa-heart mr-1 text-cyber-red"></i> Aayush &amp; Prerna</span>
                        <button onclick="copyText('${escapeHtml(item.text)}')" class="text-gray-400 hover:text-cyber-red transition">
                            <i class="fa-solid fa-copy"></i> Copy
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function filterShayariLang(lang, button) {
            activeLanguage = lang;
            document.querySelectorAll('.lang-tab').forEach(btn => {
                btn.classList.remove('bg-cyber-red', 'text-black');
                btn.classList.add('bg-black', 'text-cyber-blue');
            });
            button.classList.add('bg-cyber-red', 'text-black');
            button.classList.remove('bg-black', 'text-cyber-blue');
            searchShayari();
        }

        function searchShayari() {
            const query = document.getElementById('shayariSearch').value.toLowerCase().trim();
            const filtered = shayariDatabase.filter(item => {
                const matchesLang = (activeLanguage === 'all' || item.lang === activeLanguage);
                const matchesQuery = item.text.toLowerCase().includes(query) || item.target.toLowerCase().includes(query) || item.lang.toLowerCase().includes(query);
                return matchesLang && matchesQuery;
            });
            renderShayaris(filtered);
        }

        function escapeHtml(str) {
            return str.replace(/'/g, "\\'").replace(/"/g, '&quot;');
        }

        function copyText(text) {
            const temp = document.createElement('textarea');
            temp.value = text;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            document.body.removeChild(temp);
            alert('Shayari copied to clipboard!');
        }

        function runQuantumScan() {
            const status = document.getElementById('scanStatus');
            const progress = document.getElementById('scanProgress');

            status.innerText = "SCANNING AAYUSH & PRERNA'S FREQUENCY...";
            status.className = "font-orbitron text-sm font-bold text-cyber-blue animate-pulse";
            progress.style.width = "0%";

            let current = 0;
            const interval = setInterval(() => {
                current += 10;
                progress.style.width = current + "%";

                if (current >= 100) {
                    clearInterval(interval);
                    status.innerText = "MATCH RESULT: 100% INFINITE LOVE SYNC!";
                    status.className = "font-orbitron text-sm font-bold text-cyber-red text-glow-red";
                }
            }, 150);
        }

        const loveNotes = [
            "Prerna, in every parallel universe and digital realm, my heart will always navigate directly to you.",
            "Aayush Thakur & Pure Love Prerna Nagre represent an unbreakable bond that transcends time.",
            "You are the cybernetic light in my darkest nights, Prerna.",
            "No algorithm in this world could ever calculate how deeply Aayush loves Prerna.",
            "To the world, you are one person, but to Aayush, Prerna is the entire universe."
        ];

        function generateLoveNote() {
            const randomIndex = Math.floor(Math.random() * loveNotes.length);
            document.getElementById('generatedMessage').innerText = `"${loveNotes[randomIndex]}"`;
        }

        function copyLoveNote() {
            const text = document.getElementById('generatedMessage').innerText;
            copyText(text);
        }

        let audioCtx = null;
        let isAudioPlaying = false;
        let oscillator = null;

        function toggleBackgroundAudio() {
            const btn = document.getElementById('audioBtn');
            if (!isAudioPlaying) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();

                oscillator.type = 'sine';
                oscillator.frequency.setValueAtTime(220, audioCtx.currentTime);
                gainNode.gain.setValueAtTime(0.05, audioCtx.currentTime);

                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);
                oscillator.start();

                isAudioPlaying = true;
                btn.innerHTML = '<i class="fa-solid fa-volume-high"></i> AMBIENCE: ON';
                btn.classList.remove('bg-cyber-red');
                btn.classList.add('bg-cyber-blue');
            } else {
                if (oscillator) oscillator.stop();
                isAudioPlaying = false;
                btn.innerHTML = '<i class="fa-solid fa-music"></i> AMBIENCE: OFF';
                btn.classList.remove('bg-cyber-blue');
                btn.classList.add('bg-cyber-red');
            }
        }

        const heartCanvas = document.getElementById('heartCanvas');
        const hCtx = heartCanvas.getContext('2d');
        let particles = [];

        function resizeCanvas() {
            heartCanvas.width = window.innerWidth;
            heartCanvas.height = window.innerHeight;
        }

        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        class Particle {
            constructor() {
                this.x = Math.random() * heartCanvas.width;
                this.y = heartCanvas.height + Math.random() * 100;
                this.size = Math.random() * 12 + 6;
                this.speedY = Math.random() * 1.5 + 0.5;
                this.color = Math.random() > 0.5 ? '#ff0033' : '#00d2ff';
                this.opacity = Math.random() * 0.7 + 0.3;
            }

            update() {
                this.y -= this.speedY;
                if (this.y < -20) {
                    this.y = heartCanvas.height + 20;
                    this.x = Math.random() * heartCanvas.width;
                }
            }

            draw() {
                hCtx.globalAlpha = this.opacity;
                hCtx.fillStyle = this.color;
                hCtx.font = `${this.size}px FontAwesome`;
                hCtx.fillText('♥', this.x, this.y);
                hCtx.globalAlpha = 1.0;
            }
        }

        for (let i = 0; i < 35; i++) {
            particles.push(new Particle());
        }

        function animateParticles() {
            hCtx.clearRect(0, 0, heartCanvas.width, heartCanvas.height);
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateParticles);
        }

        window.onload = function() {
            renderShayaris(shayariDatabase);
            animateParticles();
        };
    </script>
</body>
</html>
